#!/usr/bin/env bash
set -euo pipefail

BUDGET_FILE="/workspace/.probe_budget"
SIMS="${SIMS_PER_PROBE:-3}"

if [[ ! -f "$BUDGET_FILE" ]]; then
  echo "probe budget file missing" >&2
  exit 1
fi

remaining="$(cat "$BUDGET_FILE")"
if [[ "$remaining" -le 0 ]]; then
  echo "probe budget exhausted" >&2
  exit 1
fi

probe_id="$((26 - remaining))"
echo "$((remaining - 1))" > "$BUDGET_FILE"

env -i \
  PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
  HOME=/root \
  PYTHONNOUSERSITE=1 \
  python3 -I /opt/robotrumble/run_probe_impl.py "$probe_id" "$SIMS"
