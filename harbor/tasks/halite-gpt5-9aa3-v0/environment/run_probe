#!/usr/bin/env bash
# Trusted Halite probe oracle. Intended sudo target for the unprivileged agent.
set -euo pipefail

export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
unset PYTHONPATH PYTHONHOME PYTHONSTARTUP PYTHONDONTWRITEBYTECODE || true
export PYTHONNOUSERSITE=1

BUDGET_FILE="/workspace/.probe_budget"
if [[ ! -f "$BUDGET_FILE" ]]; then
  echo "probe budget missing" >&2
  exit 2
fi

remaining="$(cat "$BUDGET_FILE")"
if [[ "$remaining" -le 0 ]]; then
  echo "probe budget exhausted" >&2
  exit 3
fi

probe_id=$((25 - remaining + 1))
echo $((remaining - 1)) > "$BUDGET_FILE"
SIMS="${SIMS_PER_PROBE:-3}"

env -i \
  PATH="$PATH" \
  HOME=/root \
  PYTHONNOUSERSITE=1 \
  python3 -I /opt/halite/run_probe_impl.py "$probe_id" "$SIMS"
